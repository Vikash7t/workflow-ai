{
  "name": "workflow-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Intelligent, Predictive, AI-Native Project Management SaaS",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run dev --workspace=@workflow-ai/api",
    "dev:web": "npm run dev --workspace=@workflow-ai/web",
    "build": "npm run build --workspaces --if-present",
    "build:contracts": "npm run build --workspace=@workflow-ai/contracts",
    "build:api": "npm run build --workspace=@workflow-ai/api",
    "build:web": "npm run build --workspace=@workflow-ai/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run build:contracts && npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:migrate": "npm run db:migrate --workspace=@workflow-ai/api",
    "db:generate": "npm run db:generate --workspace=@workflow-ai/api",
    "db:seed": "npm run db:seed --workspace=@workflow-ai/api",
    "db:studio": "npm run db:studio --workspace=@workflow-ai/api"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
